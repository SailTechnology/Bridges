#!/bin/bash
set -euo pipefail
umask 077
BRIDGES_PACKAGE_DIR=$(CDPATH= cd -- "$(/usr/bin/dirname -- "$0")" && pwd)
BRIDGES_LAUNCH_DIR="$HOME/Applications/Bridges"
BRIDGES_BACKUP_DIR="$HOME/Projects/Bridges/launcher-backups"
BRIDGES_LAUNCHER="$BRIDGES_LAUNCH_DIR/部署章鱼地面站.command"
/bin/mkdir -p "$BRIDGES_LAUNCH_DIR" "$BRIDGES_BACKUP_DIR"
if [[ -e "$BRIDGES_LAUNCHER" ]]; then
  if ! /usr/bin/grep -q '^# Generated by Bridges$' "$BRIDGES_LAUNCHER"; then
    echo 'An existing launcher at this location belongs to another application; it was preserved.' >&2
    exit 1
  fi
  /bin/cp -p "$BRIDGES_LAUNCHER" "$BRIDGES_BACKUP_DIR/launcher-$(/bin/date +%Y%m%d-%H%M%S)-$$.command"
fi
BRIDGES_TEMP_LAUNCHER=$(/usr/bin/mktemp "$BRIDGES_LAUNCH_DIR/launcher.XXXXXX")
printf '#!/bin/bash\n# Generated by Bridges\nexec /bin/bash %q\n' "$BRIDGES_PACKAGE_DIR/一键部署章鱼地面站.command" > "$BRIDGES_TEMP_LAUNCHER"
/bin/chmod 700 "$BRIDGES_TEMP_LAUNCHER"
/bin/mv -f "$BRIDGES_TEMP_LAUNCHER" "$BRIDGES_LAUNCHER"
BRIDGES_DESKTOP_LINK="$HOME/Desktop/部署章鱼地面站.command"
if [[ -d "$HOME/Desktop" && ! -e "$BRIDGES_DESKTOP_LINK" && ! -L "$BRIDGES_DESKTOP_LINK" ]]; then
  /bin/ln -s "$BRIDGES_LAUNCHER" "$BRIDGES_DESKTOP_LINK"
  printf 'Desktop deployment button installed: %s\n' "$BRIDGES_DESKTOP_LINK"
else
  printf 'Launcher installed; existing Desktop items preserved: %s\n' "$BRIDGES_LAUNCHER"
fi
